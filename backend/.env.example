# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for explanations
GEMINI_MODEL=gemini-2.5-flash

# Max repo size to clone, in MB
MAX_REPO_SIZE_MB=200

# Timeout (seconds) for scanner processes
SCAN_TIMEOUT_SECONDS=180

# Max findings to send to Gemini per scan (cost control)
MAX_FINDINGS_TO_EXPLAIN=25

# Temporary repo clone directory (outside project to avoid --reload triggers)
TMP_REPO_DIR=/tmp/vulnascan_repos

# LLM response cache directory
CACHE_DIR=/tmp/vulnascan_cache

# Cache TTL in seconds (default 7 days)
CACHE_TTL_SECONDS=604800
